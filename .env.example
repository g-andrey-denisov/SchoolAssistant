# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Whitelist Telegram user-id через запятую. ПУСТО = бот закрыт для всех.
ALLOWED_USER_IDS=

# ── LLM backend (команды / интент-парсинг) ────────────────────────────────────
# openai   → облачный OpenAI (OPENAI_API_KEY + OPENAI_MODEL)
# lmstudio → локальный LM Studio (LMSTUDIO_BASE_URL + LMSTUDIO_MODEL)
LLM_BACKEND=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# LM Studio (OpenAI-совместимый сервер)
LMSTUDIO_BASE_URL=http://192.168.1.10:1234/v1
LMSTUDIO_MODEL=qwen3.5-9b-claude-4.6-highiq-instruct

# Таймаут запроса к LLM (секунды)
LLM_TIMEOUT=60

# ── STT backend (голосовые сообщения) ─────────────────────────────────────────
# openai   → облачный OpenAI Whisper (OPENAI_API_KEY + STT_MODEL=whisper-1)
# custom   → сторонний OpenAI-совместимый сервер (STT_BASE_URL + STT_MODEL)
# disabled → голосовые сообщения отключены, бот просит писать текстом
#
# Примеры комбинаций:
#   LLM_BACKEND=openai   + STT_BACKEND=openai   → всё через OpenAI
#   LLM_BACKEND=lmstudio + STT_BACKEND=openai   → команды локально, голос через OpenAI
#   LLM_BACKEND=openai   + STT_BACKEND=custom   → команды OpenAI, голос на своём сервере
#   LLM_BACKEND=lmstudio + STT_BACKEND=disabled → только текст, без голоса
STT_BACKEND=openai
STT_MODEL=whisper-1
STT_TIMEOUT=60
# URL для STT_BACKEND=custom (LM Studio НЕ поддерживает транскрипцию):
# STT_BASE_URL=http://172.16.10.38:8000/v1

# ── Google Sheets ──────────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
GOOGLE_SPREADSHEET_ID=

# ── Логирование ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=7
