# ── Telegram ──────────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Whitelist Telegram user-id через запятую. ПУСТО = бот закрыт для всех.
ALLOWED_USER_IDS=

# ── LLM backend: openai | lmstudio ────────────────────────────────────────────
LLM_BACKEND=openai

# OpenAI
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini

# LM Studio (OpenAI-совместимый сервер)
LMSTUDIO_BASE_URL=http://172.16.10.38:1234/v1
LMSTUDIO_MODEL=qwen3.5-9b-claude-4.6-highiq-instruct

# Таймаут запроса к LLM (секунды)
LLM_TIMEOUT=60

# ── STT (голосовые сообщения через Whisper) — опционально ──────────────────────
# Внимание: LM Studio НЕ поддерживает /v1/audio/transcriptions. Для STT нужен
# либо облачный OpenAI (STT_BASE_URL пуст + OPENAI_API_KEY + STT_MODEL=whisper-1),
# либо отдельный whisper-сервер (speaches/whisper.cpp) через STT_BASE_URL.
STT_MODEL=whisper-1
STT_TIMEOUT=60
# Отдельный OpenAI-совместимый whisper-сервер; пусто = облачный OpenAI.
# STT_BASE_URL=http://172.16.10.38:8000/v1

# ── Google Sheets ──────────────────────────────────────────────────────────────
GOOGLE_CREDENTIALS_FILE=credentials/service_account.json
GOOGLE_SPREADSHEET_ID=1BxiMVs0XRA5nFMdKvBdBZjgmUUqptlbs74OgVE2upms

# ── Логирование ────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=5242880
LOG_BACKUP_COUNT=7
